# Public browser-safe values
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_PROFILE_IMAGE_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_PORTFOLIO_SOURCE_URL=
NEXT_PUBLIC_CONTACT_EMAIL=

# Server-only values; never prefix these with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
# Hosted release-only PostgreSQL URL for the isolated pgTAP gate; never expose to the browser
SUPABASE_DB_URL=
INNGEST_EVENT_KEY=local-test-event-key
INNGEST_SIGNING_KEY=local-test-signing-key
AI_PRIMARY_SECRET_REF=secret://local/ai-primary
# Example production embedding credential. In Settings → AI providers, use
# OPENAI_API_KEY as the secret reference; the secret itself remains server-only.
OPENAI_API_KEY=
# Optional Cohere Rerank credential. Register provider `cohere` with model
# `rerank-v3.5`, capability `reranker`, and secret reference `COHERE_API_KEY`.
COHERE_API_KEY=
# Optional override for a Cohere-compatible rerank endpoint.
COHERE_RERANK_URL=
# Optional OpenAI-compatible Responses API proxy for owner-only live job discovery.
OPENAI_RESPONSES_URL=
# Native Codex App Server runtime for the shared orchestrator. The web server
# starts this command for each bounded subagent turn and uses the local Codex
# login. CODEX_APP_SERVER_ARGS is a JSON string array.
CODEX_APP_SERVER_COMMAND=codex
CODEX_APP_SERVER_ARGS=["app-server","--stdio"]
# Optional when the Next.js process is launched outside this repository root.
CODEX_PROJECT_ROOT=
# Reserved for a future remote app-server transport; native local mode does not need a URL.
CODEX_APP_SERVER_URL=
CODEX_APP_SERVER_MODEL=gpt-5.6-sol
# Base64 of a Google service-account JSON key. Share only the configured folder
# with its client_email as Viewer; never grant it access to the rest of Drive.
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON_BASE64=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_FOLDER_NAME=Resumes
CAREER_WORKER_URL=http://127.0.0.1:8081
CAREER_WORKER_SHARED_SECRET=
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
SENTRY_DSN=
POSTHOG_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=Basil Ogbonna <portfolio@your-domain.com>
CONTACT_EMAIL=

# Optional job-discovery provider credentials. In Settings → Job sources, store
# only these variable names in secret_ref; never paste the actual keys there.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=gb
JSEARCH_RAPIDAPI_KEY=
FLYBYAPIS_RAPIDAPI_KEY=
SERPAPI_API_KEY=
THEIRSTACK_API_KEY=
JOBSPIPE_API_KEY=
